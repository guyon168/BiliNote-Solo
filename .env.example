# ==================== 通用端口配置 ====================
BACKEND_PORT=8483 # 后端端口
FRONTEND_PORT=3015
BACKEND_HOST=0.0.0.0 # 默认为 0.0.0.0，表示监听所有 IP 地址 不建议动
APP_PORT=3015 # docker 部署时用

# 前端访问后端用 (开发环境使用)
VITE_API_BASE_URL=http://127.0.0.1:8483
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
VITE_FRONTEND_PORT=3015

# ==================== 生产环境配置 ====================
ENV=production
STATIC=/static

# 图片基础 URL（前端访问截图的路径前缀）
IMAGE_BASE_URL=/static/screenshots

# FFMPEG 配置
FFMPEG_BIN_PATH=/usr/local/bin/ffmpeg

# ==================== 数据目录（外置隔离） ====================
# 将所有运行时产生的数据（数据库、笔记、截图、上传文件、中间文件等）
# 统一存到此目录下，避免项目代码目录膨胀，方便清理。
#
# 若不设置，默认回退到项目根目录（backend/ 的上级目录）。
# macOS 示例：
DATA_DIR=/Users/macalpha/Projects/BiliNoteData
# Linux 示例：
# DATA_DIR=/data/BiliNoteData
# Windows 示例：
# DATA_DIR=D:\BiliNoteData

# 数据库路径（优先级高于 DATA_DIR 下的默认位置）
# 默认为 {DATA_DIR}/bili_note.db
# DATABASE_URL=sqlite:///bili_note.db

# 模型文件目录（whisper 模型等大文件，默认 {DATA_DIR}/models）
# MODELS_DIR=/path/to/models

# ==================== transcriber 相关配置 ====================
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou/mlx-whisper(仅Apple平台)/groq
WHISPER_MODEL_SIZE=medium

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo # groq提供的faster-whisper 默认为 whisper-large-v3-turbo
